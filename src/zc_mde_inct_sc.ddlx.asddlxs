@Metadata.layer: #CORE

@UI.headerInfo: { 
                  typeName: 'Incident',
                  typeNamePlural: 'Incidents',
                  title: {
                            value: 'IncidentId'
                          }
                 }


@UI.presentationVariant: [{ sortOrder: [{ 
                                          by: 'IncidentId',
                                          direction: #ASC
                                         }
                                        ]
                            }]
annotate entity ZC_DT_INCT_SC with
{

  @UI.facet: [{ 
                id: 'GeneralInformation',
                type: #IDENTIFICATION_REFERENCE,
                label: 'General Information',
                position: 10 
               },
               { 
                  id: 'History',
                  type: #LINEITEM_REFERENCE,
                  label: 'History',
                  position: 20,
                  targetElement: '_Historial'
                }]
  @UI.lineItem: [{ 
                   type: #FOR_ACTION,
                   dataAction: 'ChangeStatus',
                   label: 'Change Status',
                   position: 80,
                   importance: #HIGH,
                   exclude: true        // prueba si funciona app
                 }]
  @UI.identification: [{  
                          type: #FOR_ACTION,
                          dataAction: 'ChangeStatus',
                          label: 'Change Status',
                          position: 80,
                          importance: #HIGH
                      }]
  IncUuid;


  @UI.lineItem:       [{ position: 10, importance: #MEDIUM }]
  @UI.identification: [{ position: 10 }]
  @UI.selectionField: [{ position: 10 }]
  IncidentId;

  @UI.lineItem:       [{ position: 20, importance: #LOW }]
  @UI.identification: [{ position: 20 }]
  Title;


  @UI.lineItem:       [{ position: 30, importance: #LOW }]
  @UI.identification: [{ position: 30 }]
  Description;

  @UI.lineItem:       [{ position: 40, importance: #LOW }]
  @UI.identification: [{ position: 40 }]
  @UI.selectionField: [{ position: 20 }]
  Status;

  @UI.lineItem:       [{ position: 50, importance: #LOW }]
  @UI.identification: [{ position: 50 }]
  @UI.selectionField: [{ position: 30 }]
  Priority;

  @UI.lineItem:       [{ position: 60, importance: #LOW }]
  @UI.identification: [{ position: 60 }]
  @UI.selectionField: [{ position: 40 }]
  CreationDate;

  @UI.lineItem:       [{ position: 70, importance: #LOW }]
  @UI.identification: [{ position: 70 }]
  @UI.selectionField: [{ position: 50 }]
  ChangedDate;
}