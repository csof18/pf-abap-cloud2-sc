@Metadata.layer: #CORE
@UI: {  headerInfo: { typeName: 'Incident',
                      typeNamePlural: 'Incidents',
                      title: {  type: #STANDARD,
                                label: 'Incident Id ',
                                value: 'IncidentId'
                              },
                      description: { type: #STANDARD,
                                     label: 'Inceidente',   //ver porque no se ve
                                     value: 'Title' }
                     },
                     presentationVariant: [{ sortOrder: [{ by: 'IncidentId',
                                                           direction: #ASC
                                                         }],
                                             visualizations: [{ type: #AS_LINEITEM }]
                                           }]

     }
//@UI.headerInfo: {
//                  typeName: 'Incident',
//                  typeNamePlural: 'Incidents',
//                  title: {  type: #STANDARD,
//                  label: 'Incident Id ',
//                            value: 'IncidentId'
//                          },
//                  description: { type: #STANDARD,
//                                 label: 'Inceidente',   //ver porque no se ve
//                                 value: 'Title' }
//                 }


//@UI.presentationVariant: [{ sortOrder: [{
//                                          by: 'IncidentId',
//                                          direction: #ASC
//                                         }],
//                             visualizations: [{ type: #AS_LINEITEM }]
//                            }]
annotate entity ZC_DT_INCT_SC with
{

  @UI.facet: [{ id: 'GeneralInformation',
                purpose: #STANDARD,
                type: #IDENTIFICATION_REFERENCE,
                label: 'General Information',
                position: 10
               },
               {  id: 'History',
                  purpose: #STANDARD,
                  type: #LINEITEM_REFERENCE,
                  label: 'History',
                  position: 20,
                  targetElement: '_Historial'
                }]
  @UI.hidden: true
  @UI:{ lineItem: [{ position: 9,
                     importance: #HIGH },
                   { type: #FOR_ACTION,
                     dataAction: 'ChangeStatus',
                     label: 'Change Status',
                     position: 10 }//,
                   //{ hidden: true }
                   ],
        identification: [{  position: 10 },
                         {  type: #FOR_ACTION,
                            dataAction: 'ChangeStatus',
                            label: 'Change Status',
                            position: 10
                         }//,
                         //{ hidden: true }
                         ]
        }
  //@UI.hidden: true
  IncUuid;


  @UI: {  lineItem: [{ position: 10,            //VISTA
                       importance: #MEDIUM,
                       label: 'Incident Id' }],
          selectionField: [{ position: 10 }],   //FILTRO
          identification: [{ position: 20,      //DETALLE
                             label: 'Incident Id' }]   //para que se vea en el detalle
        }
  @Consumption.valueHelpDefinition: [{ entity: { name: 'ZI_INCT_SC',
                                                 element: 'IncidentId' }//,
  //                                       useForValidation: true
                                       }]
  IncidentId;

  @UI:{ lineItem: [{ position: 20,
                     importance: #LOW,
                     label: 'Title' }],
        identification: [{ position: 30 }]
      }
  //  @Consumption.filter.hidden: true
  //  @UI.hidden: true              //para que no se muestre tampoco en el  filtro
  Title;


  @UI: { lineItem: [{ position: 30,
                      importance: #LOW,
                      label: 'Description' }],
         identification: [{ position: 40 }]
        }
  //  @UI.hidden: true
  Description;

  @UI: {  lineItem: [{ position: 40,
                       importance: #LOW,
                       label: 'Status' }],
        selectionField: [{ position: 20 }],
        identification: [{ position: 50 }],
        textArrangement: #TEXT_FIRST
      }
  @Consumption.valueHelpDefinition: [{ entity: { name: 'ZI_STATUS_SC',
                                                 element: 'StatusCode' } //,
  //                                       useForValidation: true
  }]
  Status;


  @UI: {  lineItem: [{ position: 50,
                       importance: #LOW,
                       label: 'Priority' }],
        selectionField: [{ position: 30 }],
        identification: [{ position: 60 }],
        textArrangement: #TEXT_FIRST
      }
  @Consumption.valueHelpDefinition: [{ entity: { name: 'ZI_PRIORITY_SC',
                                                 element: 'PriorityCode' } //,
  //                                         useForValidation: true
  }]
  Priority;

  @UI: { lineItem: [{ position: 60,             //VISTA
                      importance: #LOW,
                      label: 'Creation Date' }],
         selectionField: [{ position: 40 }],   //FILTRO
         identification: [{ position: 70,       //DETALLE
                            label: 'Creation Date' }]
      }
  @Consumption.valueHelpDefinition: [{ entity: { name: 'ZI_INCT_SC',
                                                 element: 'CreationDate' }//,
  //                                       useForValidation: true
                                      }]
  CreationDate;

  @UI: {  lineItem: [{ position: 70,
                       importance: #LOW,
                       label: 'Changed Date' }],
        selectionField: [{ position: 50 }],
        identification: [{ position: 80 }]
      }
  @Consumption.valueHelpDefinition: [{ entity: { name: 'ZI_INCT_SC',
                                                element: 'ChangedDate' }//,
  //                                       useForValidation: true
                                      }]
  ChangedDate;

    @Consumption.filter.hidden: true
  @UI.hidden: true
  LocalCreatedBy;

    @Consumption.filter.hidden: true
  @UI.hidden: true
  LocalCreatedAt;

    @Consumption.filter.hidden: true
  @UI.hidden: true
  LocalLastChangedBy;

  @Consumption.filter.hidden: true
  @UI.hidden: true
  LocalLastChangedAt;

  @Consumption.filter.hidden: true
  @UI.hidden: true
  LastChangedAt;
}
