@Metadata.layer: #CUSTOMER
//@Metadata.layer: #CORE
@UI: { headerInfo: { typeName: 'History',
                     typeNamePlural: 'History',
                     title: { type: #STANDARD,
                              value: 'HisId' },
                              description: { type: #STANDARD,
                                             label: 'History details',   //ver porque no se ve
                                             value: 'Text' }
                            },
       presentationVariant: [{ sortOrder: [{ by: 'HisId',
                                             direction: #DESC
                                            }],
                                visualizations: [{ type: #AS_LINEITEM }]
                            }]
     }
@UI.createHidden: true
@UI.updateHidden: true
@UI.deleteHidden: true
annotate entity ZC_DT_INCT_H_SC with
{
    @UI.facet: [{ id: 'History',
                  purpose: #STANDARD,
                  type: #IDENTIFICATION_REFERENCE,
                  label: 'History details',
                  position: 10//,
                }]

  @UI.identification: [{ label: 'IncUuid',position: 1 }]
  @UI.hidden: true
  IncUuid;

  @UI.identification: [{ label: 'HisUuid',position: 2 }]
  @UI.hidden: true
  HisUuid;

  @UI: {  lineItem: [{ position: 10,        
                     importance: #MEDIUM,
                     label: 'History ID' }],
        identification: [{ position: 20,      
                           label: 'History ID' }]  
      }
  HisId;

  @UI: {  lineItem: [{ position: 20,
                       importance: #LOW,
                       label: 'Previous Status' }],
          identification: [{ position: 20 }],
          textArrangement: #TEXT_FIRST
      }
  PreviousStatus;

  @UI: {  lineItem: [{ position: 30,
                       importance: #LOW,
                       label: 'New Status' }],
          identification: [{ position: 30 }],
          textArrangement: #TEXT_FIRST
      }
  NewStatus;

  @UI: { lineItem: [{ position: 40,
                      importance: #LOW,
                      label: 'Observation' }],
         identification: [{ position: 40,
                            label: 'Observation' }]
       }
  Text;

  @Consumption.filter.hidden: true
  @UI.identification: [{ label: 'Local Created By',position: 50 }]
  @UI.hidden: true
  LocalCreatedBy;

  @UI.identification: [{ label: 'Local Created At',position: 60 }]
  @Consumption.filter.hidden: true
  @UI.hidden: true
  LocalCreatedAt;

  @UI.identification: [{ label: 'LocalLastChangedBy',position: 70 }]
  @Consumption.filter.hidden: true
  @UI.hidden: true
  LocalLastChangedBy;

  @UI.identification: [{ label: 'LocalLastChangedAt',position: 80 }]
  @Consumption.filter.hidden: true
  @UI.hidden: true
  LocalLastChangedAt;

  @UI.identification: [{ label: 'LastChangedAt',position: 90 }]
  @Consumption.filter.hidden: true
  @UI.hidden: true
  LastChangedAt;
}