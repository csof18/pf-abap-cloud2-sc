 projection;
 strict ( 2 );
 use draft;
 extensible;

 define behavior for ZC_DT_INCT_SC alias Incident
 extensible
 {
   use create;
   use update;
   use delete;

   use action ChangeStatus;

   use action Resume;
   use action Edit;
   use action Activate;
   use action Discard;
   use action Prepare;

   side effects
   {
     action ChangeStatus affects entity _Historial;
   }

   use association _Historial { with draft; }
   //  use association _Historial { create; with draft; }
 }

 define behavior for ZC_DT_INCT_H_SC alias IncidentHis
 {
//   use update;
//   use delete;

   use association _Incident { with draft; }
 }