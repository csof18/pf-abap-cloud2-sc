managed implementation in class zbp_i_inct_sc unique;
strict ( 2 );
with draft;

extensible
{ with additional save;
  with determinations on modify;
  with validations on save;
  with determinations on save;
}

define behavior for ZI_INCT_SC alias Incident
persistent table zdt_inct_sc
draft table zdt_inctd_sc

lock master
total etag LastChangedAt
etag master LocalLastChangedAt
authorization master ( global, instance )
extensible
{
  create ( authorization : global );
  update;
  delete;
  field ( numbering : managed, readonly ) IncUuid;

  //  Campos solo lectura
  field ( readonly ) IncidentId,
  Status,
  ChangedDate,
  CreationDate,
  LocalCreatedBy,
  LocalCreatedAt,
  LocalLastChangedBy,
  LocalLastChangedAt,
  LastChangedAt;

  //  Campos obligatorios
  field ( mandatory ) Title, Description, Priority;

  association _Historial { create; with draft; }


  //  accion RAP para cambiar de estado
  action ( features : instance, authorization : update ) ChangeStatus parameter ZAE_CHANGE_STATUS_SC result [1] $self;

  side effects
  {
    action ChangeStatus affects entity _Historial;
  }

  validation validationIncident on save { create; update; }

  validation validationStatus on save { create; update; field Status; }

  validation validationPriorityCode on save { create; update; field Priority; }

  validation validateDateRange on save { create; update; field CreationDate, ChangedDate; }

  validation validateDateFuture on save { create; update; field CreationDate, ChangedDate; }

  validation validateDeleteIncident on save { delete; }

  determination setIncident on modify { create; }


  determination createInitialHistory on save { create; }

  draft action Resume;
  draft action Edit;
  draft action Activate optimized;
  draft action Discard;

  draft determine action Prepare
  {
    validation validationIncident;
    validation validateDateRange;
    validation validateDateFuture;
    validation validationStatus;
    validation validationPriorityCode;
  }


  //  Agregando mapeo
  mapping for zdt_inct_sc
    {
      IncUuid            = inc_uuid;
      Status             = status;
      Priority           = priority;
      IncidentId         = incident_id;
      Title              = title;
      Description        = description;
      CreationDate       = creation_date;
      ChangedDate        = changed_date;
      LocalCreatedBy     = local_created_by;
      LocalCreatedAt     = local_created_at;
      LocalLastChangedBy = local_last_changed_by;
      LocalLastChangedAt = local_last_changed_at;
      LastChangedAt      = last_changed_at;
      zzresponzag        = zzresponzag;
    }
}

define behavior for ZI_INCT_H_SC alias IncidentHis
persistent table zdt_inct_h_sc
draft table zdt_inctd_h_sc

lock dependent by _Incident
authorization dependent by _Incident
{
  update ( features : instance );
  delete ( features : instance );

  field ( numbering : managed, readonly ) HisUuid;

  field ( readonly ) IncUuid,
  HisId,
  PreviousStatus,
  NewStatus,
  Text,
  LocalCreatedBy,
  LocalCreatedAt,
  LocalLastChangedBy,
  LocalLastChangedAt,
  LastChangedAt;

  association _Incident { with draft; }
  mapping for zdt_inct_h_sc
    {
      IncUuid            = inc_uuid;
      HisUuid            = his_uuid;
      HisId              = his_id;
      PreviousStatus     = previous_status;
      NewStatus          = new_status;
      Text               = text;
      LocalCreatedBy     = local_created_by;
      LocalCreatedAt     = local_created_at;
      LocalLastChangedBy = local_last_changed_by;
      LocalLastChangedAt = local_last_changed_at;
      LastChangedAt      = last_changed_at;
    }

}